<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- tvOS 规范 Info.plist：不含 iOS 专属的 LSRequiresIPhoneOS -->
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>MinimumOSVersion</key><string>26.0</string>
	<!-- tvOS device family = 3 (Apple TV) -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>3</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- tvOS 必需：支持的界面方向 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- tvOS 必需：launch screen（无 storyboard 时用空 dict） -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- 局域网日志回传（Bonjour 发现开发机 + TCP 长连接）所需隐私声明 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问本地网络，以将运行日志回传到同一局域网的开发机，用于诊断数据获取问题。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_hgtvlog._tcp</string>
	</array>
	<!-- 本地播放代理：AVPlayer 走 http://127.0.0.1 明文，需放行本地网络 ATS -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>